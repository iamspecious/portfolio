# Copy this to .env and fill in real values. Never commit .env — only this
# example file, with placeholders, belongs in the repo.

# ─────────────────────────────────────────────────────────────────────────
# Remote — the one LIVE integration in this project (public sandbox).
# ─────────────────────────────────────────────────────────────────────────

# "sandbox" or "production". Defaults to "sandbox" if unset, so forgetting
# to set this fails safe rather than pointing at real payroll data.
# sandbox base URL:    https://gateway.remote-sandbox.com
# production base URL: https://gateway.remote.com
REMOTE_ENV=sandbox

# OAuth2 client-credentials pair from the Remote sandbox partner dashboard.
REMOTE_CLIENT_ID=
REMOTE_CLIENT_SECRET=

# The signing secret configured on the Remote webhook subscription. Used to
# verify X-Remote-Signature (HMAC-SHA256, hex, over raw_body + ":" + timestamp).
REMOTE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Ashby — DOCUMENTED-PAYLOAD SIMULATOR ONLY. There is no live call to a
# real Ashby account anywhere in this project. These are still required to
# exercise ashby_client.py's request-building/response-checking logic
# against a stub, and are read from the environment the same way real
# credentials would be, so nothing changes if this ever points at a real
# account. See README.md's honesty note.
# ─────────────────────────────────────────────────────────────────────────

ASHBY_API_KEY=
ASHBY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# HiBob — DOCUMENTED-PAYLOAD SIMULATOR ONLY, same as Ashby above.
# ─────────────────────────────────────────────────────────────────────────

HIBOB_SERVICE_USER_ID=
HIBOB_SERVICE_USER_TOKEN=
HIBOB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Receiver
# ─────────────────────────────────────────────────────────────────────────

RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=8787
DB_PATH=hr_integration.sqlite3

# Dry-run is ON by default. Only the literal value "false" turns it off —
# unset, empty, "False", "0", anything else stays dry. See config.py.
DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────
# ngrok (local tunnelling during development only)
# ─────────────────────────────────────────────────────────────────────────

# Free ngrok is fine for pointing a platform's webhook config at your
# laptop while developing. It is NOT fine for anything production-adjacent
# — the URL is unauthenticated by default and rotates on every restart,
# which for a real HR data flow is a real exposure, not a convenience
# trade-off. See README.md.
NGROK_AUTHTOKEN=
